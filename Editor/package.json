{
  "name": "cecily-tasks-editor",
  "private": true,
  "description": "The Markdown editor Cecily Tasks shows in a web view: CodeMirror 6 with ProseMark. `npm run build` writes CecilyTasks/Editor/editor.js.",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/editor.js --bundle --minify --format=iife --target=safari17 --outfile=../CecilyTasks/Editor/editor.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.1",
    "@prosemark/core": "0.0.11"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
